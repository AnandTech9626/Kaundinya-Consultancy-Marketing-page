# Environment Configuration for @kaundinya/api
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <db_username> and <db_password> with your actual credentials
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@kaundinya-cluster.xfugqu2.mongodb.net/kaundinya?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=kaundinya_jwt_super_secret_production_key_2026

# Public App URLs for CORS
CORS_ORIGIN=*

# Dev Mode Flags
DEV_OTP=123456
