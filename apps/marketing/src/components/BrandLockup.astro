---
type BrandSize = "sm" | "md" | "lg";

interface Props {
  size?: BrandSize;
  class?: string;
  tone?: "gold" | "brown";
}

const {
  size = "md",
  class: className = "",
  tone = "gold",
} = Astro.props;

const toneClass = tone === "brown" ? "text-[#281C12]" : "text-gold";

const ICON_HEIGHT: Record<BrandSize, string> = {
  sm: "h-10",
  md: "h-16",
  lg: "h-24",
};

const TITLE_SIZE: Record<BrandSize, string> = {
  sm: "text-[14px]",
  md: "text-[20px]",
  lg: "text-3xl",
};

const SUBTITLE_SIZE: Record<BrandSize, string> = {
  sm: "text-[7px]",
  md: "text-[10px]",
  lg: "text-[12px]",
};
---

<div
  class={`flex items-center gap-1 ${className}`}
  style="font-family: Manrope, sans-serif"
>
  <img
    src="/images/brand-mark.webp"
    alt="Kaundinya"
    class={`${ICON_HEIGHT[size]} w-auto shrink-0 object-contain`}
    width="64"
    height="64"
  />
  <div class="flex min-w-0 flex-col">
    <span
      class={`font-black leading-none tracking-[0.18em] ${toneClass} ${TITLE_SIZE[size]}`}
    >
      KAUNDINYA
    </span>
    <span
      class={`mt-1 whitespace-nowrap font-bold uppercase leading-none tracking-[0.22em] ${toneClass} ${SUBTITLE_SIZE[size]}`}
    >
      Integrated Services
    </span>
  </div>
</div>
