 ---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-4">
  <ol class="flex items-center flex-wrap gap-2 text-xs text-muted">
    <li>
      <a href="/" class="hover:text-charcoal transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Home</span>
      </a>
    </li>
    {items.map((item, idx) => (
      <li class="flex items-center gap-2">
        <span class="text-border-subtle">/</span>
        {item.href && idx < items.length - 1 ? (
          <a href={item.href} class="hover:text-charcoal transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="font-semibold text-charcoal" aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
