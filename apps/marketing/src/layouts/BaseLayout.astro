---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsultationModal from '../components/ConsultationModal';
import { SITE_INFO, CONTACT_PERSONS } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  serviceName?: string;
  serviceDescription?: string;
}

const {
  title = `${SITE_INFO.name} — ${SITE_INFO.tagline}`,
  description = SITE_INFO.description,
  image = '/og-image.png',
  type = 'website',
  noindex = false,
  serviceName,
  serviceDescription,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_INFO.url);
const siteTitle = title.includes(SITE_INFO.name) ? title : `${title} | ${SITE_INFO.name}`;
const imageURL = new URL(image, SITE_INFO.url).toString();
const organizationId = `${SITE_INFO.url}/#organization`;
const websiteId = `${SITE_INFO.url}/#website`;

const BREADCRUMB_LABELS: Record<string, string> = {
  about: 'About Us',
  services: 'Services',
  'real-estate': 'Real Estate',
  insurance: 'Insurance Advisory',
  loans: 'Loan Advisory',
  'property-home-services': 'Property & Home Services',
  contact: 'Contact',
  privacy: 'Privacy Notice',
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = [
  { name: 'Home', url: `${SITE_INFO.url}/` },
  ...segments.map((segment, index) => ({
    name: BREADCRUMB_LABELS[segment] ?? segment.replace(/-/g, ' '),
    url: `${SITE_INFO.url}/${segments.slice(0, index + 1).join('/')}/`,
  })),
];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'ProfessionalService',
    '@id': organizationId,
    name: SITE_INFO.name,
    alternateName: SITE_INFO.fullName,
    description: SITE_INFO.description,
    url: `${SITE_INFO.url}/`,
    logo: `${SITE_INFO.url}/images/logo.webp`,
    image: imageURL,
    telephone: CONTACT_PERSONS[0]?.phoneRaw,
    priceRange: '₹₹',
    areaServed: [
      { '@type': 'City', name: 'Hyderabad' },
      { '@type': 'City', name: 'Secunderabad' },
      { '@type': 'AdministrativeArea', name: 'Telangana' },
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Hyderabad',
      addressRegion: 'Telangana',
      addressCountry: 'IN',
    },
    knowsAbout: [
      'Real Estate Rentals and Purchases',
      'Insurance Advisory',
      'Property Management and Balcony Safety Nets',
      'Loans and Financial Documentation Guidance',
    ],
    contactPoint: CONTACT_PERSONS.map((person) => ({
      '@type': 'ContactPoint',
      contactType: 'customer service',
      name: person.name,
      telephone: person.phoneRaw,
      areaServed: 'IN',
      availableLanguage: ['English', 'Telugu', 'Hindi'],
    })),
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${SITE_INFO.url}/`,
    name: SITE_INFO.name,
    description: SITE_INFO.description,
    inLanguage: 'en-IN',
    publisher: { '@id': organizationId },
  },
];

if (segments.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL.toString()}#breadcrumb`,
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}

if (serviceName) {
  graph.push({
    '@type': 'Service',
    '@id': `${canonicalURL.toString()}#service`,
    name: serviceName,
    serviceType: serviceName,
    description: serviceDescription ?? description,
    url: canonicalURL.toString(),
    provider: { '@id': organizationId },
    areaServed: { '@type': 'City', name: 'Hyderabad' },
  });
}

const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en-IN" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}
    <meta name="theme-color" content="#141414" />
    <meta name="geo.region" content="IN-TG" />
    <meta name="geo.placename" content="Hyderabad" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- Icons & web app manifest -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_INFO.name} — ${SITE_INFO.tagline}`} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={SITE_INFO.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={`${SITE_INFO.name} — ${SITE_INFO.tagline}`} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-charcoal font-sans selection:bg-gold selection:text-charcoal antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-charcoal focus:text-gold focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-gold"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />

    <ConsultationModal client:load />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-open-consultation]') : null;
        if (el) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('open-consultation-modal'));
        }
      });
    </script>
  </body>
</html>
