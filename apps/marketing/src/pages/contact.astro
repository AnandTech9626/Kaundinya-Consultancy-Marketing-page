---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EnquiryForm from '../components/EnquiryForm';
import { SITE_INFO, CONTACT_PERSONS } from '../lib/constants';
---

<BaseLayout
  title="Contact Us — Kaundinya Consultancy, Hyderabad"
  description="Contact Kaundinya Consultancy in Hyderabad for real estate, insurance, property & home services, and loan guidance. Call +91 70933 20947 or request a consultation online."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
  </div>

  <section class="py-12 sm:py-16 bg-ivory-light border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-charcoal tracking-tight">
        Talk to Kaundinya Consultancy
      </h1>
      <p class="mt-4 max-w-2xl text-base text-muted leading-relaxed">
        Share your requirement and our team will get back to you. We serve Hyderabad and
        surrounding areas across real estate, insurance, property &amp; home services, and loans.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-2xl border border-border-subtle p-6 bg-white shadow-sm space-y-4">
          <h2 class="text-xl font-extrabold text-charcoal">Call us</h2>
          {CONTACT_PERSONS.map((person) => (
            <div class="border-t border-border-subtle pt-3 first:border-0 first:pt-0">
              <p class="text-sm font-bold text-charcoal">{person.name}</p>
              <p class="text-xs text-muted">{person.role}</p>
              <a
                href={`tel:${person.phoneRaw}`}
                class="mt-1 inline-block text-sm font-bold text-gold hover:underline"
              >
                {person.phone}
              </a>
            </div>
          ))}
        </div>

        <div class="rounded-2xl border border-border-subtle p-6 bg-white shadow-sm space-y-3">
          <h2 class="text-xl font-extrabold text-charcoal">Service area</h2>
          <p class="text-sm text-muted leading-relaxed">{SITE_INFO.serviceArea}</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Hyderabad%2C+Telangana"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex text-sm font-bold text-gold hover:underline"
          >
            Open Hyderabad on Google Maps
          </a>
          <p class="text-xs text-muted">
            Consultations by appointment. Please call before visiting to confirm availability.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <EnquiryForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
