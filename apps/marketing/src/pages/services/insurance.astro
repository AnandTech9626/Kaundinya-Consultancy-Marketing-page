---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { SITE_INFO, CONTACT_PERSONS } from '../../lib/constants';

const primaryContact = CONTACT_PERSONS[0];

const insuranceTypes = [
  {
    title: "Life & Term Insurance Advisory",
    desc: "A pure term life insurance policy provides the most cost-effective financial safety net for your dependents. We help you calculate your adequate sum assured, assess riders (critical illness, accidental disability), and review claim settlement track records.",
    points: ["Income replacement calculation", "Pure term vs endowment analysis", "Rider suitability guidance"]
  },
  {
    title: "Health & Family Floater Insurance",
    desc: "With rising medical costs in Hyderabad, having an adequate health cover is vital. We help you decode fine print: room rent limits, pre-existing disease waiting periods, copay clauses, and day-care procedures so you don't face surprises during a hospital admission.",
    points: ["Cashless hospital network evaluation", "Room rent capping clarity", "Restoration & no-claim bonus review"]
  },
  {
    title: "Two-Wheeler & Four-Wheeler Motor Insurance",
    desc: "From mandatory third-party liability to comprehensive bumper-to-bumper packages with zero depreciation, engine protect, and roadside assistance, we help you renew or select policies that offer practical roadside support in Telangana.",
    points: ["Zero depreciation & consumable cover", "NCB (No Claim Bonus) transfer guidance", "Timely renewal coordination"]
  },
  {
    title: "Property & Home Asset Insurance",
    desc: "Safeguard your apartment, villa, or commercial property against fire, floods, natural calamities, electrical short circuits, and burglary. We help you assess structure and content valuation accurately.",
    points: ["Structure vs contents coverage", "Burglary & electrical breakdown riders", "Tenant vs owner insurance guidance"]
  }
];
---

<BaseLayout
  title={`Insurance Advisory Services in Hyderabad     ${SITE_INFO.name}`}
  description="Objective guidance on Life, Health, Motor, and Property insurance in Hyderabad from Kaundinya Consultancy. Clear policy reviews without sales pressure."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs 
      items={[
        { label: "Services", href: "/services" },
        { label: "Insurance" }
      ]} 
    />
  </div>

  <!-- Hero Header -->
  <section class="py-12 sm:py-16 bg-ivory-light border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold text-charcoal tracking-tight">
            Objective Insurance Guidance for You & Your Family.
          </h1>
          <p class="text-base sm:text-lg text-muted leading-relaxed">
            Avoid confusion over complex policy clauses, arbitrary agent promises, and hidden sub-limits. Kaundinya Consultancy helps you review, compare, and select genuine insurance coverage suited to your actual circumstances.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-consultation
              class="inline-flex items-center justify-center font-semibold rounded-md transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 gap-2 cursor-pointer bg-gold hover:bg-gold-hover active:bg-gold-muted text-charcoal shadow-sm focus:ring-gold border border-gold text-sm px-5 py-2.5"
            >
              <span>Request Policy Review</span>
            </button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl overflow-hidden border border-border-subtle shadow-lg">
            <img 
              src="/images/insurance.webp" 
              alt="Indian family sitting happily representing security and insurance peace of mind" 
              class="w-full h-72 sm:h-88 object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Offerings -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <SectionHeading 
        badge="Insurance Categories"
        title="Coverage Types We Help You Navigate"
        subtitle="Unbiased comparisons focused on what policies cover, what they exclude, and which insurer matches your needs."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {insuranceTypes.map((item) => (
          <div class="p-8 rounded-2xl bg-ivory/60 border border-border-subtle flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="h-1 w-8 bg-gold"></div>
              <h3 class="text-xl font-bold text-charcoal">{item.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>

            <div class="pt-4 border-t border-border-subtle/60 space-y-2">
              <p class="text-xs font-bold uppercase tracking-wider text-charcoal">What We Review:</p>
              <ul class="space-y-1.5 text-xs text-charcoal-light">
                {item.points.map(p => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Advisory Disclaimer -->
      <div class="p-6 rounded-xl bg-ivory border border-border-subtle text-xs text-muted leading-relaxed">
        <strong>Statutory Notice:</strong> Insurance is the subject matter of solicitation. Kaundinya Consultancy acts as an advisory facilitator. Final terms, premium rates, underwriting approvals, and claims settlements are determined solely by the respective IRDAI-registered insurance companies in accordance with their policy terms and conditions.
      </div>
    </div>
  </section>

</BaseLayout>
