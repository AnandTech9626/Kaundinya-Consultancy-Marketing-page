---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { SITE_INFO, CONTACT_PERSONS } from '../../lib/constants';

const primaryContact = CONTACT_PERSONS[0];

const loanCategories = [
  {
    title: "Home Loans (Purchase & Construction)",
    desc: "Navigating bank eligibility calculations, legal clearance of property documents, and valuation reports can delay your dream home. We help you prepare your paperwork, compare interest rates across recognized nationalized and private banks, and guide your application from submission to disbursement.",
    points: ["Purchase of new & resale apartments/villas", "Plot purchase + construction loans", "Balance transfer with top-up options"]
  },
  {
    title: "Personal Loans",
    desc: "When urgent personal expenses, medical emergencies, or family events arise, we help you evaluate unsecured personal loan options. We review interest structures, foreclosure terms, processing fees, and tenure flexibility to ensure you do not get trapped in predatory high-interest debt.",
    points: ["Clear comparison of effective APRs", "Pre-closure penalty assessment", "Minimal documentation guidance for salaried & self-employed"]
  },
  {
    title: "Business Loans & Working Capital",
    desc: "Fuel your enterprise growth in Hyderabad with structured financing. We assist small and medium business owners in compiling financial balance sheets, GST returns, and projected cash flows to apply for unsecured business loans, machinery finance, or working capital credit lines.",
    points: ["Working capital & term loan documentation", "MSME scheme eligibility review", "Cash flow and turnover benchmarking"]
  },
  {
    title: "Loan Against Property (Mortgage Loans)",
    desc: "Leverage the equity in your residential or commercial property in Hyderabad to access larger funds at substantially lower interest rates than unsecured loans. We assist in preparing title chain records, municipal approvals, and valuation documentation.",
    points: ["Lower interest rates compared to personal loans", "Longer repayment tenures up to 15 years", "Residential and commercial collateral evaluation"]
  }
];

const documentationSteps = [
  {
    title: "1. KYC & Identity Verification",
    items: ["PAN Card", "Aadhaar Card", "Current Address Proof", "Passport-size Photographs"]
  },
  {
    title: "2. Income Documentation",
    items: ["Last 3-6 months Salary Slips / Form 16 (Salaried)", "Last 2-3 years ITR with Computation (Self-Employed)", "Last 6-12 months Bank Account Statements"]
  },
  {
    title: "3. Property Documents (Secured Loans)",
    items: ["Registered Sale Deed / Link Deeds", "Approved Building Plan / Municipal Permission", "Latest Property Tax Receipt & Encumbrance Certificate (EC)"]
  }
];
---

<BaseLayout
  title={`Loan Advisory & Documentation Guidance in Hyderabad          ${SITE_INFO.name}`}
  description="Home loans, personal loans, business loans, and loan against property in Hyderabad from Kaundinya Consultancy. Factual advisory without unrealistic promises."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs 
      items={[
        { label: "Services", href: "/services" },
        { label: "Loans" }
      ]} 
    />
  </div>

  <!-- Hero Header with Realistic Photo -->
  <section class="py-12 sm:py-16 bg-ivory-light border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold text-charcoal tracking-tight">
            Objective Loan Evaluation & Documentation Support.
          </h1>
          <p class="text-base sm:text-lg text-muted leading-relaxed">
            Securing a loan should not come with misleading interest calculations or surprise processing deductions. We assist you in reviewing your eligibility, organizing your financial papers, and approaching the right lending partners.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-consultation
              class="inline-flex items-center justify-center font-semibold rounded-md transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 gap-2 cursor-pointer bg-gold hover:bg-gold-hover active:bg-gold-muted text-charcoal shadow-sm focus:ring-gold border border-gold text-sm px-5 py-2.5"
            >
              <span>Request Loan Guidance</span>
            </button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-border-subtle shadow-xl group">
            <img 
              src="/images/loans.webp" 
              alt="Home loan and mortgage financial paperwork with house key" 
              class="w-full h-72 sm:h-88 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Detailed Categories -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <SectionHeading 
        badge="Loan Options"
        title="Lending Categories We Help You Evaluate"
        subtitle="Transparent comparisons of loan tenures, interest rates, and eligibility criteria."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {loanCategories.map((item) => (
          <div class="p-8 rounded-2xl bg-ivory/60 border border-border-subtle flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="h-1 w-8 bg-gold"></div>
              <h3 class="text-xl font-bold text-charcoal">{item.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>

            <div class="pt-4 border-t border-border-subtle/60 space-y-2">
              <p class="text-xs font-bold uppercase tracking-wider text-charcoal">Key Focus Points:</p>
              <ul class="space-y-1.5 text-xs text-charcoal-light">
                {item.points.map(p => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Documentation Preparation Checklist -->
      <div class="bg-ivory rounded-2xl p-8 sm:p-10 border border-border-subtle space-y-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gold">Preparation Checklist</span>
          <h3 class="text-2xl font-bold text-charcoal mt-1">General Documentation Required</h3>
          <p class="text-sm text-muted mt-1">Organizing your files in advance avoids unnecessary bank back-and-forth.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {documentationSteps.map((step) => (
            <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-3">
              <h4 class="text-sm font-bold text-charcoal">{step.title}</h4>
              <ul class="space-y-2 text-xs text-muted">
                {step.items.map(it => (
                  <li class="flex items-start gap-2">
                    <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Statutory Disclosure -->
      <div class="p-6 rounded-xl bg-ivory border border-border-subtle text-xs text-muted leading-relaxed space-y-1">
        <p><strong>Financial & Statutory Disclosure:</strong></p>
        <p>
          Kaundinya Consultancy is a facilitation and documentation advisory firm. We are not a direct lender, bank, or Non-Banking Financial Company (NBFC). We do not guarantee loan approvals or sanction amounts. All loan sanctions, interest rates, processing fees, and disbursal timelines are determined solely by the respective RBI-regulated lending institutions based on their independent credit policies, CIBIL scores, and risk assessment.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
