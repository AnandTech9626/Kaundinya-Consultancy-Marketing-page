---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { SITE_INFO, CONTACT_PERSONS } from '../../lib/constants';

const primaryContact = CONTACT_PERSONS[0];

const homeServicesList = [
  {
    title: "Pigeon Safety Nets & Invisible Grills",
    desc: "Balcony bird droppings and safety concerns are persistent challenges for Hyderabad high-rise apartments. We coordinate high-density UV-stabilized copolymer pigeon nets and high-tensile 316-grade stainless steel invisible grills that keep your balcony clean and secure without blocking your ventilation or panoramic view.",
    features: ["UV-treated durable nylon nets", "316 marine-grade stainless steel invisible grills", "Neat, damage-free anchor fastening by experienced fitters"]
  },
  {
    title: "Air Conditioner (AC) & Refrigerator Servicing",
    desc: "Hyderabad summers demand dependable cooling. We coordinate prompt, qualified technicians for pre-season jet pump cleaning, refrigerant gas leak detection, compressor testing, and PCB diagnostics for split ACs, inverter ACs, and refrigerators.",
    features: ["Deep pressure-jet foam washing", "Accurate gas charging (R32, R410A)", "Transparent pricing for replacement parts"]
  },
  {
    title: "Aadhaar & Voter ID Update Assistance Coordination",
    desc: "Updating addresses on government identification documents following a move can be confusing and time-consuming. We provide guidance on acceptable supporting documents (rental deed, utility bills), appointment booking, and correction procedures for Aadhaar and Voter ID cards.",
    features: ["Document checklist verification", "Official slot booking assistance", "Guidance on Form 8 and address correction procedures"]
  },
  {
    title: "Interior Design Consultation & Modular Coordination",
    desc: "Turn your empty apartment or villa into a cohesive, functional living space. We connect you with practical interior designers for floor space planning, modular kitchen layout design, custom wardrobes, and materials consultation within realistic budgets.",
    features: ["Spatial planning & layout blueprints", "Modular kitchen & wardrobe material review", "Budget-aligned execution coordination"]
  }
];
---

<BaseLayout
  title={`Property Management & Home Services in Hyderabad          ${SITE_INFO.name}`}
  description="Pigeon nets, invisible grills, AC repair, Aadhaar update coordination, and interior consultation in Hyderabad from Kaundinya Consultancy."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs 
      items={[
        { label: "Services", href: "/services" },
        { label: "Property & Home Services" }
      ]} 
    />
  </div>

  <!-- Hero Header with Realistic Photo -->
  <section class="py-12 sm:py-16 bg-ivory-light border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7 space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold text-charcoal tracking-tight">
            Dependable Home Maintenance & Balcony Safety.
          </h1>
          <p class="text-base sm:text-lg text-muted leading-relaxed">
            From keeping your balcony clean and pigeon-free with invisible grills and nets to servicing cooling appliances, updating resident documentation, and planning home interiors, we provide coordinated, dependable execution.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-consultation
              class="inline-flex items-center justify-center font-semibold rounded-md transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 gap-2 cursor-pointer bg-gold hover:bg-gold-hover active:bg-gold-muted text-charcoal shadow-sm focus:ring-gold border border-gold text-sm px-5 py-2.5"
            >
              <span>Book Home Service Consultation</span>
            </button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-border-subtle shadow-xl group">
            <img 
              src="/images/home_services.webp" 
              alt="Professional technician servicing home equipment and maintenance" 
              class="w-full h-72 sm:h-88 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Detailed Offerings -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <SectionHeading 
        badge="Maintenance & Support Services"
        title="Solutions for a Safe & Well-Maintained Home"
        subtitle="Vetted technicians, honest pricing, and direct oversight for complete peace of mind."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {homeServicesList.map((item) => (
          <div class="p-8 rounded-2xl bg-ivory/60 border border-border-subtle flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="h-1 w-8 bg-gold"></div>
              <h3 class="text-xl font-bold text-charcoal">{item.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>

            <div class="pt-4 border-t border-border-subtle/60 space-y-2">
              <p class="text-xs font-bold uppercase tracking-wider text-charcoal">Standards & Highlights:</p>
              <ul class="space-y-1.5 text-xs text-charcoal-light">
                {item.features.map(f => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Regulatory Notice -->
      <div class="p-6 rounded-xl bg-ivory border border-border-subtle text-xs text-muted leading-relaxed space-y-1">
        <p><strong>Civic & Operational Transparency:</strong></p>
        <p>
          1. <strong>Government Documents:</strong> Kaundinya Consultancy provides procedural coordination, appointment scheduling, and document checklist guidance only. We do not represent UIDAI, ECI, or any government authority, nor do we promise guaranteed approvals. All updates are vetted and processed solely by authorized government centers.
        </p>
        <p>
          2. <strong>Technician Coordination:</strong> Installations and maintenance are executed by qualified third-party technicians coordinated under our service standards.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
