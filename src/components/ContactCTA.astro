---
import { CONTACT_PERSONS } from '../lib/constants';
import EnquiryForm from './EnquiryForm';
---

<section id="consultation" class="py-12 sm:py-16">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
      
      <!-- Left Column: Black Card (Same Height!) -->
      <div class="lg:col-span-5 h-full">
        <div class="bg-charcoal text-white rounded-2xl p-7 sm:p-8 border border-charcoal-light shadow-xl flex flex-col justify-between h-full space-y-6">
          
          <!-- Top Section -->
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gold">
              <span class="w-5 h-0.5 bg-gold"></span>
              <span>TALK TO OUR TEAM</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
              We're here to help you get started.
            </h2>
            <p class="text-xs sm:text-sm text-ivory/70 leading-relaxed">
              Contact us about real estate, insurance, loans, property management or home services.
            </p>
          </div>

          <!-- Middle Section: Leadership Contacts -->
          <div class="space-y-4">
            <div class="border-t border-charcoal-light/70 pt-4 space-y-1">
              <p class="text-[11px] text-ivory/60 font-medium">Managing Director / Principal</p>
              <p class="text-sm font-bold text-white">Sampath Krishna Goud</p>
            </div>

            <div class="border-t border-charcoal-light/70 pt-4 space-y-1">
              <p class="text-[11px] text-ivory/60 font-medium">Managing Partner</p>
              <p class="text-sm font-bold text-white">Harika Garre</p>
            </div>
          </div>

          <!-- Bottom Section: Service Area -->
          <div class="border-t border-charcoal-light/70 pt-4 space-y-1">
            <p class="text-[11px] text-ivory/60 font-medium">Service area</p>
            <p class="text-sm font-bold text-white flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Hyderabad & surrounding areas</span>
            </p>
          </div>

        </div>
      </div>

      <!-- Right Column: White Form Card (Same Height!) -->
      <div class="lg:col-span-7 h-full">
        <EnquiryForm client:visible />
      </div>

    </div>
  </div>
</section>
