 ---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  class?: string;
  dark?: boolean;
}

const {
  badge,
  title,
  subtitle,
  centered = false,
  class: className = "",
  dark = false,
} = Astro.props;
---

<div class={`space-y-3 ${centered ? 'text-center mx-auto max-w-3xl' : 'max-w-2xl'} ${className}`}>
  {badge && (
    <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase ${
      dark ? 'bg-gold/20 text-gold border border-gold/30' : 'bg-gold/15 text-charcoal border border-gold/40'
    }`}>
      <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
      <span>{badge}</span>
    </div>
  )}
  <h2 class={`text-3xl sm:text-4xl font-extrabold tracking-tight ${dark ? 'text-white' : 'text-charcoal'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-base sm:text-lg leading-relaxed ${dark ? 'text-ivory/80' : 'text-muted'}`}>
      {subtitle}
    </p>
  )}
  <div class={`h-1 w-12 bg-gold rounded-full ${centered ? 'mx-auto' : ''}`}></div>
</div>
