---
import type { ServiceCategory } from '../lib/constants';

interface Props {
  category: ServiceCategory;
  index: number;
}

const { category, index } = Astro.props;
---

<article class="group bg-white rounded-2xl border border-border-subtle hover:border-gold/60 transition-all duration-300 shadow-sm hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between overflow-hidden h-full">
  
  {category.image && (
    <div class="relative h-40 w-full overflow-hidden bg-ivory">
      <img 
        src={category.image} 
        alt={category.name} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading={index < 2 ? "eager" : "lazy"}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent"></div>
      
      <!-- Top category tag -->
      <div class="absolute top-2.5 left-2.5">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-charcoal/85 backdrop-blur-md text-white border border-white/10 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
          <span>Pillar 0{index + 1}</span>
        </span>
      </div>

      <!-- Bottom overlay city -->
      <div class="absolute bottom-2.5 right-3">
        <span class="text-gold font-semibold bg-charcoal/80 px-2 py-0.5 rounded text-[10px]">
          Hyderabad
        </span>
      </div>
    </div>
  )}

  <div class="p-5 flex-1 flex flex-col justify-between space-y-3.5">
    
    <div class="space-y-1.5">
      <h3 class="text-base font-bold text-charcoal group-hover:text-gold-hover transition-colors leading-snug min-h-[2.5rem] flex items-center">
        {category.name}
      </h3>
      <p class="text-xs text-muted leading-relaxed line-clamp-2">
        {category.description}
      </p>
    </div>

    <div class="pt-2.5 border-t border-border-subtle/80 space-y-1.5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Key Assistance:</p>
      <ul class="space-y-1.5 text-xs text-charcoal-light">
        {category.services.slice(0, 3).map((svc) => (
          <li class="flex items-start gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 mt-1"></span>
            <span class="leading-tight text-[11px] line-clamp-1">{svc}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="pt-3 border-t border-border-subtle/50">
      <a 
        href={category.href} 
        class="inline-flex items-center justify-between w-full text-xs font-bold text-charcoal group-hover:text-gold transition-colors focus:outline-none"
      >
        <span>Explore Service</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1 duration-200 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

  </div>
</article>
