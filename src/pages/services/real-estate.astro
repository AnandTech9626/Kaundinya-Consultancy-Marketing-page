---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { SITE_INFO, CONTACT_PERSONS } from '../../lib/constants';

const primaryContact = CONTACT_PERSONS[0];

const serviceDetails = [
  {
    title: "Residential & Commercial Property Rentals",
    desc: "Finding rental housing or commercial space in Hyderabad can involve unverified listings, hidden broker terms, and unexpected deposit demands. We assist tenants and landlords with authentic property scouting, site visits, rental agreements, and fair lease negotiations.",
    highlights: ["Verified rental listings", "Lease agreement drafting assistance", "Tenant screening & landlord coordination"]
  },
  {
    title: "Property Buying Assistance",
    desc: "Purchasing a flat, independent house, or commercial plot is a major milestone. We guide you through evaluating localities, comparing market prices, understanding developer credentials, and coordinating basic document reviews so you can proceed with confidence.",
    highlights: ["Locality & price comparison across Hyderabad", "Title & link document checklist review", "Site visit accompaniment"]
  },
  {
    title: "Property Selling Assistance",
    desc: "If you are an owner looking to sell residential or commercial property in Hyderabad, we help you determine realistic market pricing, coordinate authentic prospective buyer visits, and facilitate smooth communication without predatory brokerage practices.",
    highlights: ["Realistic price benchmarking", "Filtered buyer inquiries", "Closing documentation assistance"]
  }
];
---

<BaseLayout
  title={`Real Estate Services in Hyderabad     ${SITE_INFO.name}`}
  description="Transparent property rental, buying, and selling assistance in Hyderabad from Kaundinya Consultancy. Ethical guidance with zero high-pressure tactics."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs 
      items={[
        { label: "Services", href: "/services" },
        { label: "Real Estate" }
      ]} 
    />
  </div>

  <!-- Hero Header -->
  <section class="py-12 sm:py-16 bg-ivory-light border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gold/15 text-charcoal border border-gold/40">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            <span>Pillar 01     Real Estate</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-charcoal tracking-tight">
            Real Estate Guidance Built on Local Trust.
          </h1>
          <p class="text-base sm:text-lg text-muted leading-relaxed">
            Whether you are looking to rent, buy, or sell property in Hyderabad and surrounding areas, Kaundinya Consultancy provides realistic, honest advisory without pressure tactics or hidden commissions.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-consultation
              class="inline-flex items-center justify-center font-semibold rounded-md transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 gap-2 cursor-pointer bg-gold hover:bg-gold-hover active:bg-gold-muted text-charcoal shadow-sm focus:ring-gold border border-gold text-sm px-5 py-2.5"
            >
              <span>Request Property Consultation</span>
            </button>
            <a 
              href={`tel:${primaryContact.phoneRaw}`}
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-charcoal bg-white border border-border-subtle rounded-md hover:border-gold transition-colors"
            >
              <svg class="w-4 h-4 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Call: {primaryContact.phone}</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl overflow-hidden border border-border-subtle shadow-lg">
            <img 
              src="/images/real_estate.jpg" 
              alt="Residential apartments in Hyderabad" 
              class="w-full h-72 sm:h-88 object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Offerings -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <SectionHeading 
        badge="Scope of Assistance"
        title="How We Support Your Property Journey"
        subtitle="Practical services designed to save you time and protect your financial interests."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {serviceDetails.map((item) => (
          <div class="p-7 rounded-2xl bg-ivory/60 border border-border-subtle flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="h-1 w-8 bg-gold"></div>
              <h3 class="text-xl font-bold text-charcoal">{item.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>

            <div class="pt-4 border-t border-border-subtle/60 space-y-2">
              <p class="text-xs font-bold uppercase tracking-wider text-charcoal">Key Highlights:</p>
              <ul class="space-y-1.5 text-xs text-charcoal-light">
                {item.highlights.map(h => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Advisory Disclaimer -->
      <div class="p-6 rounded-xl bg-ivory border border-border-subtle text-xs text-muted leading-relaxed">
        <strong>Professional Integrity Notice:</strong> Kaundinya Consultancy acts as a facilitation and advisory consultancy. We advise all property buyers and sellers to independently verify official revenue records, encumbrance certificates (EC), and legal titles with a certified legal advocate prior to registration.
      </div>
    </div>
  </section>

</BaseLayout>
